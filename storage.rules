rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function callPath(callId) {
      return /databases/(default)/documents/calls/$(callId);
    }

    function userExists() {
      return request.auth != null && firestore.exists(userPath());
    }

    function userRecord() {
      return firestore.get(userPath()).data;
    }

    function isActiveUser() {
      return userExists() && userRecord().isActive == true;
    }

    function isAdmin() {
      return isActiveUser() && (
        (userRecord().role == 'Admin' && userRecord().get('isDemo', false) != true)
        || (
          request.auth.uid == 'mnLf1b3jZLUIqZlgDoAgK9QrMbp1'
          && userRecord().role == 'admin'
        )
      );
    }

    function canReadCall(callId) {
      let path = callPath(callId);
      return isActiveUser()
        && firestore.exists(path)
        && (
          isAdmin()
          || (
            userRecord().role == 'Supervisor'
            && firestore.get(path).data.team == userRecord().team
          )
          || (
            userRecord().role == 'Agent'
            && firestore.get(path).data.agentId == request.auth.uid
          )
          || (
            userRecord().role == 'Demo'
            && userRecord().get('isDemo', false) == true
            && firestore.get(path).data.get('isDemo', false) == true
          )
        );
    }

    match /calls/{callId}/{fileName} {
      allow read: if canReadCall(callId);
      allow create, update: if isAdmin()
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if isAdmin();
    }
  }
}
