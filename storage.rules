rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userRecord() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn() && userRecord().active == true;
    }

    match /calls/{team}/{userId}/{fileName} {
      allow read: if activeUser() && (
        userRecord().role == 'Admin' ||
        (userRecord().role == 'Supervisor' && team == userRecord().team) ||
        (userRecord().role == 'Agent' && request.auth.uid == userId && team == userRecord().team)
      );
      allow create: if activeUser() && (
        userRecord().role == 'Admin' ||
        (userRecord().role == 'Supervisor' && team == userRecord().team) ||
        (userRecord().role == 'Agent' && request.auth.uid == userId && team == userRecord().team)
      ) && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('audio/(mpeg|wav|x-wav)');
      allow delete: if activeUser() && (
        userRecord().role == 'Admin' ||
        (userRecord().role == 'Supervisor' && team == userRecord().team)
      );
    }

    match /knowledge/{visibility}/{team}/{userId}/{fileName} {
      allow read: if activeUser() && (
        userRecord().role == 'Admin' ||
        visibility == 'Everyone' ||
        (visibility == 'Supervisors' && userRecord().role == 'Supervisor' && team == userRecord().team)
      );
      allow create: if activeUser() && (
        userRecord().role == 'Admin' ||
        (userRecord().role == 'Supervisor' && team == userRecord().team)
      )
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|application/vnd.openxmlformats-officedocument.wordprocessingml.document|text/plain)');
      allow delete: if activeUser() && (
        userRecord().role == 'Admin' ||
        (userRecord().role == 'Supervisor' && team == userRecord().team)
      );
    }
  }
}
