# Firebase web app configuration (safe to expose in the React app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=call-miner-b071d
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Express AI backend
PORT=3001
FIREBASE_PROJECT_ID=call-miner-b071d
# Choose one Firebase Admin credential method:
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or configure GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS=

# Speech-to-text: deepgram or assemblyai
STT_PROVIDER=deepgram
STT_API_KEY=
DEEPGRAM_MODEL=nova-3
STT_TIMEOUT_MS=900000

# LLM: groq or gemini
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

MAX_AUDIO_BYTES=104857600
